# ==============================================================================
# SentinelAI Production Environment Configuration Template
# Copy this file to .env.production and set cryptographically strong secrets.
# Do NOT commit active .env or .env.production files to version control!
# ==============================================================================

# System Environment Mode
SENTINEL_ENV=production
LOG_LEVEL=INFO
DEBUG=false

# API Server Host & Port
API_HOST=0.0.0.0
API_PORT=8000

# Security: Allowed Ingress Hosts (Must not contain wildcard '*' in production)
TRUSTED_HOSTS=localhost,127.0.0.1,web,api,sentinel.yourdomain.com

# Security: CORS Allowed Origins (Set strictly to your production frontend origin)
CORS_ORIGINS=http://localhost:8080,https://sentinel.yourdomain.com

# Database Connection (PostgreSQL / TimescaleDB with TLS)
POSTGRES_DB=sentinel_db
POSTGRES_USER=sentinel_admin
# MUST be explicitly set to a strong secret. 'sentinel_dev_password' will be rejected at startup!
POSTGRES_PASSWORD=replace_with_strong_random_password_min_16_characters
DATABASE_URL=postgresql://sentinel_admin:replace_with_strong_random_password_min_16_characters@postgres:5432/sentinel_db?sslmode=prefer

# Event Streaming Bus (Kafka KRaft Broker)
KAFKA_BOOTSTRAP_SERVERS=kafka:9092

# GenAI Security Analyst Configuration (Advisory Assistant)
SENTINEL_AI_PROVIDER=mock
SENTINEL_AI_MODEL=mock-analyst-v1
# In production with OpenAI or Anthropic, inject API key via secrets manager:
# SENTINEL_AI_API_KEY=sk-...
SENTINEL_AI_RATE_LIMIT_RPM=20
SENTINEL_AI_CACHE_TTL_SECONDS=3600
SENTINEL_AI_CACHE_MAX_ENTRIES=1000
