# SentinelAI Environment Configuration
# Copy this file to .env and adjust variables as needed for local development.

# System & Environment
SENTINEL_ENV=development
LOG_LEVEL=INFO
DEBUG=true

# API Server Settings (Phase 5)
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Web Dashboard (Phase 7)
VITE_API_BASE_URL=http://localhost:8000
VITE_WS_BASE_URL=ws://localhost:8000/ws

# Ingestion Settings (Phase 1)
# Mode: pcap_replay | live_passive
INGESTION_MODE=pcap_replay
CAPTURE_INTERFACE=eth0
PCAP_STORAGE_PATH=./data/samples

# Flow Engine Settings (Phase 1)
FLOW_ACTIVE_TIMEOUT_SEC=60
FLOW_INACTIVE_TIMEOUT_SEC=15

# Streaming Layer (Planned for Phase 6 - Kafka)
# KAFKA_BOOTSTRAP_SERVERS=localhost:9092
# KAFKA_TOPIC_PACKETS=sentinel.packets.raw
# KAFKA_TOPIC_FLOWS=sentinel.flows.aggregated
# KAFKA_TOPIC_ALERTS=sentinel.alerts.high

# Detection & Threat Thresholds (Phase 3 & 4)
DETECTION_CONFIDENCE_THRESHOLD=0.70
RISK_SCORE_CRITICAL_THRESHOLD=85

# GenAI Security Analyst Settings (Phase 8)
# LLM is strictly advisory (triage & playbook synthesis); not authoritative for threat detection.
# OPENAI_API_KEY=
# LLM_MODEL_NAME=gpt-4o-mini
