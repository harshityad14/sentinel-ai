# ==============================================================================
# SentinelAI Local Development Environment Configuration
# Copy this file to .env for local development with SQLite or local Docker.
# ==============================================================================

# System & Environment
SENTINEL_ENV=development
LOG_LEVEL=INFO
DEBUG=true

# API Server Settings
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8080
TRUSTED_HOSTS=*

# Web Dashboard Settings
VITE_API_BASE_URL=http://localhost:8000
VITE_WS_BASE_URL=ws://localhost:8000/api/v1/ws/alerts

# Database (SQLite for local rapid iteration, or TimescaleDB for Compose)
DATABASE_URL=sqlite:///./sentinel.db
POSTGRES_DB=sentinel_db
POSTGRES_USER=sentinel
POSTGRES_PASSWORD=sentinel_dev_password

# Streaming Layer (Kafka KRaft)
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# Passive Ingestion & Flow Engine Settings
INGESTION_MODE=pcap_replay
CAPTURE_INTERFACE=eth0
FLOW_ACTIVE_TIMEOUT_SEC=60
FLOW_INACTIVE_TIMEOUT_SEC=15

# Detection & Threat Thresholds
DETECTION_CONFIDENCE_THRESHOLD=0.70
RISK_SCORE_CRITICAL_THRESHOLD=85

# GenAI Security Analyst Settings (Phase 8)
# Provider: mock | openai | anthropic | ollama
SENTINEL_AI_PROVIDER=mock
SENTINEL_AI_MODEL=mock-analyst-v1
# SENTINEL_AI_API_KEY=
SENTINEL_AI_RATE_LIMIT_RPM=20
SENTINEL_AI_CACHE_TTL_SECONDS=3600
