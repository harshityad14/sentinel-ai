# ==============================================================================
# SentinelAI Streaming Worker — Production Multi-Stage Hardened Dockerfile
# ==============================================================================

# ------------------------------------------------------------------------------
# Stage 1: Build Dependencies & Wheels
# ------------------------------------------------------------------------------
FROM python:3.11-slim AS builder

WORKDIR /build

RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    libpq-dev \
    && rm -rf /var/lib/apt/lists/*

COPY packages/ /build/packages/
COPY apps/api/ /build/apps/api/

RUN pip install --no-cache-dir --prefix=/install \
    -e /build/packages/models \
    -e /build/packages/ingestion \
    -e /build/packages/flow_engine \
    -e /build/packages/features \
    -e /build/packages/detection \
    -e /build/packages/streaming \
    -e /build/packages/ai_agent \
    -e /build/apps/api

# ------------------------------------------------------------------------------
# Stage 2: Minimal Non-Root Runtime
# ------------------------------------------------------------------------------
FROM python:3.11-slim AS runner

RUN apt-get update && apt-get install -y --no-install-recommends \
    libpq5 \
    && rm -rf /var/lib/apt/lists/*

# Create dedicated unprivileged worker user
RUN groupadd -g 10002 workeruser && \
    useradd -u 10002 -g 10002 -m -s /bin/false workeruser

WORKDIR /workspace

COPY --from=builder /install /usr/local
COPY --from=builder /build/packages /workspace/packages
COPY --from=builder /build/apps/api /workspace/apps/api

RUN chown -R workeruser:workeruser /workspace

USER 10002:10002

# Run unified streaming pipeline runner
CMD ["python", "-m", "sentinel_streaming.runner"]
